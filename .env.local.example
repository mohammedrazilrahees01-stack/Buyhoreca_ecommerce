NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=buyhoreca.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=YOUR_STOREFRONT_PUBLIC_TOKEN
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-07
# Optional override for a Shopify customer-account vanity domain. If empty, the storefront automatically uses https://<store>.myshopify.com/account/login.
NEXT_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_URL=
NEXT_PUBLIC_SITE_URL=https://buyhoreca.com

# Optional analytics / webmaster verification
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Inventory UI: enable unauthenticated_read_product_inventory on the Storefront API token to expose exact quantityAvailable.
# The storefront falls back safely when this scope is not enabled.

# BuyHoreca AI assistant (server-only secrets; do not add NEXT_PUBLIC_ to these names)
# Create a Cloudflare API token with Workers AI access and copy your Cloudflare Account ID.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash
